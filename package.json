{
  "name": "order-execution-engine",
  "version": "1.0.0",
  "description": "Production-quality backend system for asynchronous order execution with real-time WebSocket updates",
  "main": "dist/app.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "worker": "node dist/workers/order-execution.worker.js"
  },
  "keywords": [
    "order-execution",
    "websocket",
    "bullmq",
    "fastify",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@fastify/websocket": "^11.2.0",
    "bullmq": "^5.66.0",
    "fastify": "^5.6.2",
    "ioredis": "^5.8.2",
    "pino": "^10.1.0",
    "pino-pretty": "^13.1.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.0.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
